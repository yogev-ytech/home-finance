rules_version = '2';

// Copy this file into Firebase console > Firestore Database > Rules, then Publish.
// Only the Google accounts listed below can read or write the household data.
// Everyone else, including other signed-in Google users, is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'REPLACE_WITH_EMAIL_1@gmail.com',
          'REPLACE_WITH_EMAIL_2@gmail.com'
        ];
    }

    match /households/home/{document=**} {
      allow read, write: if isFamily();
    }

    // Anything not matched above is denied by default.
  }
}
